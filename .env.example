# ==============================================================================
# Rosetta Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# Never commit the actual .env file.
# ==============================================================================

# --- Frontend (.env in /frontend) ---

# Supabase project URL (from Supabase dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1


# --- Backend (.env in /backend) ---

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (secret, server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase JWT secret (from Supabase dashboard > Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Gemini API key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Gemini model to use for translation
GEMINI_MODEL=gemini-2.0-flash

# Maximum output tokens for Gemini responses
GEMINI_MAX_OUTPUT_TOKENS=8192

# PostgreSQL connection string (async driver)
# For Supabase: postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rosetta

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Maximum translations per user per month
MONTHLY_TRANSLATION_LIMIT=100

# Maximum translation requests per user per minute
RATE_LIMIT_PER_MINUTE=20

# Maximum source code input length (characters)
MAX_SOURCE_CODE_LENGTH=10000

# Environment: "development" or "production"
# Controls OpenAPI docs visibility and log format
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
